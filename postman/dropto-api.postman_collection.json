          "name": "POST /auth/login with an empty body -> 400 (or 429 if the limiter is armed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// /auth/login is limited to 5 attempts / 60 s with a 900 s block, and the guard runs before the",
                  "// validation pipe \u2014 so a re-run inside 15 minutes legitimately answers 429 instead.",
                  "pm.test('is rejected (400, or 429 once the limiter is armed)', function () {",
                  "  pm.expect([400, 429]).to.include(pm.response.code);",
                  "});",
                  "pm.test('error body has the { status, message } shape', function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('status');",
                  "  pm.expect(b).to.have.property('message');",
                  "});",
                  "pm.test('responds under 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
