                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /auth/login with wrong credentials -> 401 (or 429 if the limiter is armed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 5 attempts / 60 s with a 900 s block, so a re-run inside 15 minutes legitimately gets 429.",
                  "// Either way the point holds: bad credentials never yield a session.",
                  "pm.test('is rejected (401, or 429 once the limiter is armed)', function () {",
                  "  pm.expect([401, 429]).to.include(pm.response.code);",
                  "});",
                  "pm.test('sets no auth cookie on a failed login', function () {",
                  "  const sc = pm.response.headers.get('set-cookie') || '';",
                  "  pm.expect(sc).to.not.include('accessToken=ey');",
                  "});",
                  "pm.test('responds under 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ],
