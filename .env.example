# Root environment — infrastructure + the web app (docker compose reads this file).
# The API's own secrets live in apps/api/.env (see apps/api/.env.example).
#
#   cp .env.example .env

# Database (PostgreSQL)
# In the full compose deployment these values create the database AND are handed to the API,
# so this file is the single source of truth for them — no need to repeat them in apps/api/.env.
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="dropto"
DB_USER="root"
DB_PASS="password"

# Redis (rate limiter)
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASS="password"
REDIS_KEY_PREFIX="dropto:"

# URLs
# APP_URL is the public origin of the web app. It is baked in at BUILD time (it feeds the
# canonical / OpenGraph / manifest URLs), so keep the runtime value identical.
APP_URL="http://localhost:3000"
# Public API base, used by the browser only for the Google OAuth redirect — so it must be an
# address the operator's browser can reach, not a container name.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Security
# Auth-cookie domain. Use a shared parent in production (e.g. ".example.com") so the web app and
# the API can both read the cookies.
COOKIE_DOMAIN="localhost"

# Branding (optional) — display name of this instance; defaults to "DropTo" when empty.
# Read on the server at runtime, so renaming needs no rebuild.
APP_NAME="DropTo"

# Web build args — inlined into the browser bundle at build time.
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_picker_api_key"
NEXT_PUBLIC_GOOGLE_APP_ID="your_google_cloud_project_number"

# Host ports the containers publish on, bound to 127.0.0.1 (docker compose only).
WEB_PORT=3000
API_PORT=4000
