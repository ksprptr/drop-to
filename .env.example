# Database (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="dropto"
DB_USER="root"
DB_PASS="password"

# Redis
REDIS_PORT=6379
REDIS_PASS="password"

# URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Security
COOKIE_DOMAIN="localhost"

# Optional: display name of this instance (web, runtime); defaults to "DropTo" when empty.
APP_NAME="DropTo"

# Web build args
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_picker_api_key"
NEXT_PUBLIC_GOOGLE_APP_ID="your_google_cloud_project_number"
