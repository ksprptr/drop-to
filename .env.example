# Root environment — infrastructure + the web app (docker compose reads this file).
# The API's own secrets live in apps/api/.env (see apps/api/.env.example).
#
#   cp .env.example .env

# Database (PostgreSQL)
POSTGRES_VERSION=18
DB_PORT=5432
DB_NAME="dropto"
DB_USER="root"
DB_PASS="password"

# Redis (rate limiter)
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASS="password"
REDIS_KEY_PREFIX="dropto:"

# URLs
APP_URL="http://localhost:3000"

# Branding (optional) — display name of this instance; defaults to "DropTo" when empty.
APP_NAME="DropTo"
# Accent color of this instance as a hex — the base shade, the rest of the ramp is derived from
# it. Drives the UI, the favicon and the OG image. Empty or invalid keeps the default green.
APP_PRIMARY_COLOR=""

# Web build args — inlined into the browser bundle at build time. Both are read only when the
# operator opens the Google Picker, so with GOOGLE_ENABLED="false" in apps/api/.env they are
# unused and can stay empty
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_picker_api_key"
NEXT_PUBLIC_GOOGLE_APP_ID="your_google_cloud_project_number"

# Host ports the containers publish on, bound to 127.0.0.1 (docker compose only).
WEB_PORT=3000
API_PORT=4000
