# Database (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="dropto"
DB_USER="root"
DB_PASS="password"

# Web — public origin (baked into prerendered SEO metadata / canonical / OpenGraph)
APP_URL="http://localhost:3000"
# Web — auth-cookie domain (shared parent so web + API share cookies in prod)
COOKIE_DOMAIN="localhost"

# Web build args
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_picker_api_key"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_oauth_client_id"
NEXT_PUBLIC_GOOGLE_APP_ID="your_google_cloud_project_number"
