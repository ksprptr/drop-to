# URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000/api/v1"

# Branding (optional) — display name of this instance; defaults to "DropTo" when empty and green if invalid color.
APP_NAME="DropTo"
APP_PRIMARY_COLOR=""

# Google Picker (browser side) — read only when the operator opens the Picker, so with
# GOOGLE_ENABLED="false" on the API they are unused and can stay empty
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_picker_api_key"
NEXT_PUBLIC_GOOGLE_APP_ID="your_google_cloud_project_number"
