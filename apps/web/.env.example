# URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Optional: server-only API base for server-to-server calls (falls back to NEXT_PUBLIC_API_URL).
# In a compose/prod deploy, point this at the API's internal address, e.g. http://dropto-api:4000/api/v1
# API_URL="http://localhost:4000/api/v1"

# Security
COOKIE_DOMAIN="localhost"

# Google Picker (browser side)
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_picker_api_key"
NEXT_PUBLIC_GOOGLE_APP_ID="your_google_cloud_project_number"
