# App
APP_PORT=4000
NODE_ENV="development"

# URLs
WEB_APP_URL="http://localhost:3000"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:4000,http://localhost:3000"

# Security
COOKIE_DOMAIN="localhost"

# JWT
JWT_ACCESS_SECRET="generate_me_access_secret"
JWT_REFRESH_SECRET="generate_me_refresh_secret"

# Database (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="dropto"
DB_USER="root"
DB_PASS="password"

# Rate limiting
RATE_LIMIT_ENABLED="true"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/google-auth/google/callback"

# Auth
AUTH_USERNAME="admin"
AUTH_PASSWORD="password"

# Token encryption
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="64_hex_character_key_generate_me_see_comment_above_0000000000000000"
