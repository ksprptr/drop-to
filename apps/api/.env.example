# App
APP_PORT=4000
NODE_ENV="development"

# URLs
WEB_APP_URL="http://localhost:3000"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:4000,http://localhost:3000"

# Security
COOKIE_DOMAIN="localhost"
# Trusted proxy hops in front of the API (Express `trust proxy`). Optional, defaults to 1. Set to
# match your topology so the rate limiter keys on the real client IP (e.g. Cloudflare Tunnel +
# Coolify may need a higher value).
# TRUST_PROXY_HOPS=1

# JWT access-token secret — must be a strong random value (>= 16 chars); placeholders are rejected
# at startup. (Refresh tokens are opaque secrets stored hashed, so they need no signing secret.)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="generate_me_access_secret"

# Database (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="dropto"
DB_USER="root"
DB_PASS="password"

# Rate limiting (Redis-backed store — shared across instances, survives redeploys)
RATE_LIMIT_ENABLED="true"
REDIS_HOST="localhost"
REDIS_PORT=6379
# Optional Redis auth (leave unset for a local/trusted Redis):
# REDIS_USER="default"
# REDIS_PASS="your_redis_password"
# REDIS_KEY_PREFIX="dropto:rl:"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/google-auth/google/callback"

# Auth
AUTH_USERNAME="admin"
AUTH_PASSWORD="password"

# S3 storage (optional second storage backend; keep "false" to disable)
S3_ENABLED="false"
# When enabled, the following are required. S3_BUCKETS is a comma-separated list
# of bucket names — each bucket is a browse root (like the Picker folders for Drive).
# S3_BUCKETS="my-bucket,another-bucket"
# S3_REGION="eu-central-1"
# S3_ACCESS_KEY_ID="your_s3_access_key_id"
# S3_SECRET_ACCESS_KEY="your_s3_secret_access_key"
# Optional — only for S3-compatible storage (MinIO, Cloudflare R2, ...):
# S3_ENDPOINT="https://minio.example.com"
# S3_FORCE_PATH_STYLE="true"

# Token encryption
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="64_hex_character_key_generate_me_see_comment_above_0000000000000000"
