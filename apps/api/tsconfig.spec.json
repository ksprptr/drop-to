{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest", "multer"],
    "isolatedModules": true,
    "esModuleInterop": true,
    // ts-jest runs in a CommonJS Jest runtime: emit CJS (transpile-only, so the
    // relaxed moduleResolution is never used for type checking) and allow the
    // ESM-only deps (cookie, archiver) to be transpiled down to CJS.
    "module": "CommonJS",
    "moduleResolution": "node10",
    "allowJs": true
  },
  "include": ["src/**/*", "test/**/*"]
}
